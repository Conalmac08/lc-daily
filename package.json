{
  "name": "lc-daily",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "simulate": "vite-node scripts/simulate.ts",
